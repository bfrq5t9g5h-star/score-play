{
  "name": "cantor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 38471",
    "build": "next build",
    "predev": "npm run build:worker",
    "prebuild": "npm run build:worker && node scripts/ensure-oemer-models.mjs",
    "build:worker": "esbuild src/lib/omr/oemer/oemer.worker.ts --bundle --outfile=public/oemer-worker.js --format=iife --platform=browser --target=es2022 --banner:js=\"importScripts('https://cdn.jsdelivr.net/npm/onnxruntime-web@1.29.0/dist/ort.min.js');\"",
    "models": "node scripts/ensure-oemer-models.mjs",
    "start": "serve out --listen 38471",
    "lint": "eslint",
    "test": "tsx src/lib/omr/run-self-test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serve": "^14.2.6",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tone": "^15.1.22",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
